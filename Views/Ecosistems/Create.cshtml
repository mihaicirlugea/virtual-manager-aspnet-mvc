@model PAW_PROJECT.Models.Ecosistem

<div class="container">
    <div class="form-container shadow-lg">
        <div class="form-header">
            <h2 class="text-white fw-bold m-0">Ecosistem Nou</h2>
        </div>

        <div class="form-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Denumire" class="form-label text-info fw-bold">Denumire Ecosistem</label>
                    <input asp-for="Denumire" class="form-control bg-dark text-white border-secondary" placeholder="Ex: Java, Fitness, Buget" />
                    <span asp-validation-for="Denumire" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ObiectivMacro" class="form-label text-info fw-bold">Obiectiv Principal</label>
                    <input asp-for="ObiectivMacro" class="form-control bg-dark text-white border-secondary" placeholder="Ce dorești să realizezi?" />
                    <span asp-validation-for="ObiectivMacro" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5">
                    <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Anulează</a>
                    <button type="submit" class="btn btn-info rounded-pill px-5 fw-bold">Creează Ecosistem</button>
                </div>
            </form>
        </div>
    </div>
</div>