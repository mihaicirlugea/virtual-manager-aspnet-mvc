@model IEnumerable<PAW_PROJECT.Models.Ecosistem>

<div class="container">
    <div class="table-container shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-white fw-bold m-0">Management Ecosisteme</h2>
            <a asp-action="Create" class="btn btn-info rounded-pill px-4">
                <i class="bi bi-plus-circle"></i> Adaugă Ecosistem Nou
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover border-secondary">
                <thead>
                    <tr class="text-info border-bottom border-info">
                        <th>Denumire</th>
                        <th>Obiectiv Principal</th>
                        <th class="text-center">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@item.Denumire</td>
                            <td class="align-middle text-secondary">@item.ObiectivMacro</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editează</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalii</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Șterge</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>