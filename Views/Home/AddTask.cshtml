<div class="container mt-5 text-white" style="max-width: 600px;">
    <div class="card bg-dark p-4 shadow-lg border-0">
        <h3 class="mb-4">Adaugă Task Nou</h3>
        <form>
            <div class="mb-3">
                <label class="form-label">Titlu Task</label>
                <input type="text" class="form-control bg-secondary text-white border-0" placeholder="Ex: Cumpărături">
            </div>
            <div class="mb-3">
                <label class="form-label">Prioritate</label>
                <select class="form-select bg-secondary text-white border-0">
                    <option>Scăzută</option>
                    <option>Medie</option>
                    <option>Ridicată</option>
                </select>
            </div>
            <button type="button" class="btn btn-info w-100 rounded-pill mt-3">Salvează Task</button>
        </form>
    </div>
</div>