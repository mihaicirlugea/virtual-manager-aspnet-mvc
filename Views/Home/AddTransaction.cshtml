<div class="container mt-5 text-white" style="max-width: 600px;">
    <h2 class="fw-bold mb-4">Tranzacție Nouă</h2>
    <form class="card bg-dark p-4 border-success">
        <div class="mb-3">
            <label class="form-label">Sumă (RON)</label>
            <input type="number" class="form-control bg-dark text-white border-secondary">
        </div>
        <div class="mb-3">
            <label class="form-label">Tip</label>
            <select class="form-select bg-dark text-white border-secondary">
                <option>Cheltuială</option>s
                <option>Venit</option>
            </select>
        </div>
        <button type="submit" class="btn btn-success w-100 rounded-pill">Adaugă în Jurnal</button>
    </form>
</div>