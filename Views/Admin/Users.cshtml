@model IEnumerable<PAW_PROJECT.Models.ApplicationUser>

<div class="table-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold m-0">Panou Administrare - Utilizatori</h2>
        <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold">Zonă Restricționată</span>
    </div>

    <table class="table table-dark table-hover align-middle m-0">
        <thead>
            <tr>
                <th>ID Utilizator</th>
                <th>Adresă Email</th>
                <th>Status Confirmat</th>
                <th>Scurtătura Profil</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="text-muted small">@user.Id</td>
                    <td class="fw-bold text-info">@user.Email</td>
                    <td>
                        @if (user.EmailConfirmed)
                        {
                            <span class="text-success">● Activ</span>
                        }
                        else
                        {
                            <span class="text-warning">● Neconfirmat</span>
                        }
                    </td>
                    <td>
                        <img src="https://ui-avatars.com/api/?name=@System.Net.WebUtility.UrlEncode(user.Email)&background=random&size=32" class="rounded-circle" style="width: 32px; height: 32px;" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>