@model PAW_PROJECT.Models.Activitate

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white shadow-lg border-warning">
                <div class="card-header border-warning">
                    <h3 class="fw-bold">Editează Activitate</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Denumire" class="form-label"></label>
                            <input asp-for="Denumire" class="form-control bg-secondary text-white border-0" />
                            <span asp-validation-for="Denumire" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EfortOre" class="form-label"></label>
                            <input asp-for="EfortOre" class="form-control bg-secondary text-white border-0" />
                            <span asp-validation-for="EfortOre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ecosistem</label>
                            <select asp-for="EcosistemId" class="form-select bg-secondary text-white border-0" asp-items="ViewBag.EcosistemId"></select>
                            <span asp-validation-for="EcosistemId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-light rounded-pill">Anulează</a>
                            <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill">Salvează Modificările</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>