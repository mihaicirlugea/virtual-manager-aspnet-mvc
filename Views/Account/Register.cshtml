@model PAW_PROJECT.Models.RegisterViewModel

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="form-container shadow-lg border-info" style="max-width: 450px; width: 100%;">
        <div class="form-header" style="background-color: rgba(34, 211, 238, 0.1); border-bottom: 1px solid #22d3ee;">
            <h3 class="text-white fw-bold m-0 text-center">Cont Nou</h3>
        </div>

        <div class="form-body p-4">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-info fw-bold">Adresă Email</label>
                    <input asp-for="Email" class="form-control bg-dark text-white border-secondary" placeholder="nume@student.upt.ro" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label text-info fw-bold">Parolă</label>
                    <input asp-for="Password" class="form-control bg-dark text-white border-secondary" placeholder="******" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label text-info fw-bold">Confirmare Parolă</label>
                    <input asp-for="ConfirmPassword" class="form-control bg-dark text-white border-secondary" placeholder="******" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-info w-100 rounded-pill fw-bold text-dark mt-2 mb-3">Creează Cont</button>

                <div class="text-center">
                    <span class="text-muted small">Ai deja un cont?</span>
                    <a asp-action="Login" class="text-info small fw-bold text-decoration-none ms-1">Autentifică-te</a>
                </div>
            </form>
        </div>
    </div>
</div>