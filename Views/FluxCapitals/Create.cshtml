@model PAW_PROJECT.Models.FluxCapital

<div class="container">
    <div class="form-container shadow-lg border-success">
        <div class="form-header" style="background-color: rgba(34, 197, 94, 0.1); border-bottom: 1px solid #22c55e;">
            <h2 class="text-white fw-bold m-0">Tranzacție Nouă</h2>
        </div>

        <div class="form-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="SumaRON" class="form-label text-info fw-bold">Sumă (RON)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-white">lei</span>
                        <input asp-for="SumaRON" class="form-control bg-dark text-white border-secondary" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="SumaRON" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Vector" class="form-label text-info fw-bold">Tip Tranzacție</label>
                    <select asp-for="Vector" class="form-select bg-dark text-white border-secondary">
                        <option value="1">Venit (+)</option>
                        <option value="-1">Cheltuială (-)</option>
                    </select>
                    <span asp-validation-for="Vector" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DataTimp" class="form-label text-info fw-bold">Data Tranzacției</label>
                    <input asp-for="DataTimp" type="datetime-local" class="form-control bg-dark text-white border-secondary"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="DataTimp" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="EcosistemId" class="form-label text-info fw-bold">Ecosistem Asociat</label>
                    <select asp-for="EcosistemId" class="form-select bg-dark text-white border-secondary" asp-items="ViewBag.EcosistemId">
                        <option value="">-- Alege Ecosistemul --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5">
                    <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Anulează</a>
                    <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold text-white">Salvează Tranzacția</button>
                </div>
            </form>
        </div>
    </div>
</div>