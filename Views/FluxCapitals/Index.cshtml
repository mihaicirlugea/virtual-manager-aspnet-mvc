@model IEnumerable<PAW_PROJECT.Models.FluxCapital>

<div class="container">
    <div class="table-container shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-white fw-bold m-0">Jurnal Financiar</h2>
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 text-white">
                Adaugă Tranzacție
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover border-secondary">
                <thead>
                    <tr class="text-info border-bottom border-info">
                        <th>Sumă (RON)</th>
                        <th>Tip</th>
                        <th>Data</th>
                        <th>Ecosistem</th>
                        <th class="text-center">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@item.SumaRON.ToString("N2")</td>
                            <td class="align-middle">
                                @if (item.Vector == 1)
                                {
                                    <span class="badge bg-success px-3">Venit</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3">Cheltuială</span>
                                }
                            </td>
                            <td class="align-middle text-secondary">@item.DataTimp.ToShortDateString()</td>
                            <td class="align-middle">@item.Ecosistem?.Denumire</td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Șterge</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>